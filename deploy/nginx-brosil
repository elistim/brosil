server {
    server_name brosil.elitepuma.ru;

    auth_basic "Private tracker";
    auth_basic_user_file /etc/nginx/.brosil_auth;

    add_header Cache-Control "private, no-store" always;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Remote-User $remote_user;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/brosil.elitepuma.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brosil.elitepuma.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name brosil.elitepuma.ru;
    return 301 https://$host$request_uri;
}
